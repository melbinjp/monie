[Unit]
Description=Monie Trading Bot
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/monie
Environment="PATH=/home/ubuntu/monie/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/ubuntu/monie/.venv/bin/python main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
