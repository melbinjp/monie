[Unit]
Description=Monie trading bot
Wants=network-online.target
After=network-online.target

[Service]
User=monie
WorkingDirectory=/opt/monie
Environment=TZ=Asia/Kolkata
UMask=0077
ExecStart=/opt/monie/.venv/bin/python /opt/monie/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
